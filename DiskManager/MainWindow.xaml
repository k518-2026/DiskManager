<Window x:Class="DiskManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:DiskManager.Views"
        Title="ディスク管理ツール" Height="820" Width="1320"
        MinHeight="620" MinWidth="1080"
        Background="{StaticResource Ink}"
        WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ヘッダー -->
        <Border Grid.Row="0" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
            <Grid Margin="20,12">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="ディスク管理ツール" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <Border Background="{StaticResource Surface}" CornerRadius="3" Padding="8,3" Margin="14,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="PrivilegeText" Style="{StaticResource Mono}" FontSize="11"
                                   Foreground="{StaticResource Muted}" Text="管理者として実行中" />
                    </Border>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="再スキャン" Command="{Binding RefreshCommand}" Margin="0,0,8,0" />
                    <Button Content="中止" Command="{Binding CancelCommand}" Margin="0" MinWidth="72" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 本体 -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="310" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ディスク一覧 -->
            <Border Grid.Column="0" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="接続されているディスク" Style="{StaticResource Eyebrow}" Margin="16,14,16,8" />
                    <ListBox ItemsSource="{Binding Disks}" SelectedItem="{Binding SelectedDisk}"
                             Background="Transparent" BorderThickness="0" Padding="8,0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0,0,0,6" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="bd" Background="{StaticResource Surface}" CornerRadius="4"
                                                    BorderBrush="Transparent" BorderThickness="1,1,1,1" Padding="12,10">
                                                <ContentPresenter />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Line}" />
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Accent}" />
                                                    <Setter TargetName="bd" Property="Background" Value="{StaticResource SurfaceHi}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <Grid>
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13" />
                                        <Border HorizontalAlignment="Right" CornerRadius="8" Padding="7,1"
                                                Background="{Binding HealthStatus, Converter={StaticResource HealthBrush}}">
                                            <TextBlock Text="{Binding HealthStatus}" FontSize="10" Foreground="#FF10141A" />
                                        </Border>
                                    </Grid>
                                    <TextBlock Text="{Binding ModelText}" Foreground="{StaticResource Text}"
                                               FontSize="11.5" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Mono}" FontSize="10.5"
                                               Foreground="{StaticResource Muted}" Margin="0,3,0,0" />
                                    <TextBlock Text="{Binding LetterSummary}" Style="{StaticResource Mono}" FontSize="10.5"
                                               Foreground="{StaticResource Accent}" Margin="0,2,0,0" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- タブ -->
            <TabControl Grid.Column="1" Margin="0" Padding="0">
                <TabItem Header="概要">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"><v:OverviewView /></ScrollViewer>
                </TabItem>
                <TabItem Header="健康状態">
                    <v:HealthView />
                </TabItem>
                <TabItem Header="パーティション">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"><v:PartitionView /></ScrollViewer>
                </TabItem>
                <TabItem Header="フォーマット">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"><v:FormatView /></ScrollViewer>
                </TabItem>
                <TabItem Header="CD / DVD">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"><v:OpticalView /></ScrollViewer>
                </TabItem>
                <TabItem Header="取り外し・ツール">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"><v:DeviceView /></ScrollViewer>
                </TabItem>
            </TabControl>
        </Grid>

        <!-- 進捗 -->
        <Border Grid.Row="2" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0">
            <Grid Margin="20,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="{Binding StatusText}" Style="{StaticResource Mono}" FontSize="11.5"
                               Foreground="{StaticResource Muted}" Margin="0,0,0,6" />
                    <ProgressBar Value="{Binding ProgressValue}" Maximum="100"
                                 IsIndeterminate="{Binding ProgressIndeterminate}" />
                </StackPanel>
                <TextBlock Grid.Column="1" VerticalAlignment="Center" Margin="16,0,0,0"
                           Style="{StaticResource Mono}" FontSize="11.5" Foreground="{StaticResource Muted}"
                           Text="{Binding ProgressValue, StringFormat={}{0:0.0} %}" />
            </Grid>
        </Border>

        <!-- ログ -->
        <Expander Grid.Row="3" IsExpanded="True" Background="{StaticResource Panel}" Foreground="{StaticResource Muted}">
            <Expander.Header>
                <TextBlock Text="実行ログ" FontFamily="{StaticResource MonoFont}" FontSize="11" Foreground="{StaticResource Muted}" />
            </Expander.Header>
            <Grid Height="190">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ListBox x:Name="LogList" Grid.Column="0" ItemsSource="{Binding LogLines}"
                         Background="{StaticResource Ink}" BorderThickness="0" Foreground="{StaticResource Text}"
                         FontFamily="{StaticResource MonoFont}" FontSize="11.5"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="10,1" />
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="Foreground" Value="{StaticResource Text}" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
                <StackPanel Grid.Column="1" Margin="12,10">
                    <Button Content="ログを保存" Command="{Binding SaveLogCommand}" />
                    <Button Content="消去" Command="{Binding ClearLogCommand}" />
                </StackPanel>
            </Grid>
        </Expander>
    </Grid>
</Window>
