<UserControl x:Class="DiskManager.Views.FormatView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Margin="24,20,24,24">

        <GroupBox Header="対象のドライブ">
            <StackPanel>
                <CheckBox Content="USB 接続のドライブだけ表示する（USB メモリ・ポータブル SSD / HDD）"
                          IsChecked="{Binding FormatUsbOnly}" Margin="0,0,0,8" />
                <ComboBox ItemsSource="{Binding FormatVolumes}" SelectedItem="{Binding SelectedFormatVolume}"
                          DisplayMemberPath="Display" MinWidth="360" HorizontalAlignment="Left" />
                <TextBlock Text="{Binding FormatTargetWarning}" TextWrapping="Wrap" Margin="0,4,0,0"
                           Foreground="{StaticResource Warn}" FontSize="12" />
                <TextBlock TextWrapping="Wrap" Margin="0,4,0,0" Foreground="{StaticResource Muted}" FontSize="11.5"
                           Text="C: と Windows の起動に使うドライブは、一覧に出しません。" />
            </StackPanel>
        </GroupBox>

        <GroupBox Header="フォーマットの種類">
            <StackPanel>
                <ComboBox SelectedIndex="{Binding FormatModeIndex, Mode=TwoWay}" MinWidth="360" HorizontalAlignment="Left">
                    <ComboBoxItem Content="簡易フォーマット（数秒）" />
                    <ComboBoxItem Content="通常フォーマット（全域ゼロ書き込み＋不良セクタ検査）" />
                    <ComboBoxItem Content="ディープフォーマット（複数回上書き・セキュリティ）" />
                </ComboBox>

                <StackPanel Orientation="Horizontal" Margin="0,4,0,6">
                    <TextBlock Text="上書き回数" VerticalAlignment="Center" Margin="0,0,8,0"
                               Foreground="{StaticResource Muted}" />
                    <ComboBox ItemsSource="{Binding PassChoices}" SelectedItem="{Binding SecurePasses}" Width="80" Margin="0" />
                </StackPanel>

                <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1"
                        CornerRadius="4" Padding="12">
                    <TextBlock Text="{Binding FormatModeDescription}" TextWrapping="Wrap" LineHeight="21"
                               Foreground="{StaticResource Text}" FontSize="12" />
                </Border>
            </StackPanel>
        </GroupBox>

        <GroupBox Header="ファイルシステムの設定">
            <WrapPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,16,8">
                    <TextBlock Text="形式" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{StaticResource Muted}" />
                    <ComboBox ItemsSource="{Binding FileSystemChoices}" SelectedItem="{Binding FormatFileSystem}"
                              Width="110" Margin="0" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,16,8">
                    <TextBlock Text="ラベル" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{StaticResource Muted}" />
                    <TextBox Text="{Binding FormatLabel, UpdateSourceTrigger=PropertyChanged}" Width="180" Margin="0" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,16,8">
                    <TextBlock Text="クラスタサイズ" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{StaticResource Muted}" />
                    <ComboBox ItemsSource="{Binding AllocationUnitChoices}" SelectedItem="{Binding AllocationUnit}"
                              Width="110" Margin="0" />
                </StackPanel>
                <CheckBox Content="NTFS 圧縮を有効にする" IsChecked="{Binding EnableCompression}" />
            </WrapPanel>
        </GroupBox>

        <WrapPanel Margin="0,0,0,14">
            <Button Content="フォーマットを実行" Command="{Binding FormatCommand}"
                    Style="{StaticResource DangerButton}" MinWidth="170" />
            <Button Content="ラベルだけ変更" Command="{Binding SetLabelCommand}" MinWidth="150" />
            <Button Content="空き領域だけ上書き" Command="{Binding WipeFreeSpaceCommand}" MinWidth="170" />
        </WrapPanel>

        <GroupBox Header="複数のドライブをまとめてフォーマット">
            <StackPanel>
                <TextBlock TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,0,0,8" LineHeight="21"
                           Text="チェックを入れたドライブを同時にフォーマットします。種類・形式・ラベル・クラスタサイズは上の設定を全部に使います。途中で止めるときは画面下の「中止」を押してください。" />
                <ItemsControl ItemsSource="{Binding FormatVolumes}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" MinWidth="240" />
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="160" />
                                    <ColumnDefinition Width="110" />
                                </Grid.ColumnDefinitions>
                                <CheckBox Grid.Column="0" Content="{Binding Display}" IsChecked="{Binding IsChecked}"
                                          IsEnabled="{Binding CanFormat}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding CapacityText}" VerticalAlignment="Center"
                                           Foreground="{StaticResource Muted}" />
                                <ProgressBar Grid.Column="2" Value="{Binding FormatPercent}" Maximum="100" Height="10"
                                             VerticalAlignment="Center" Margin="0,0,10,0" />
                                <TextBlock Grid.Column="3" Text="{Binding FormatStatus}" VerticalAlignment="Center" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="表示するドライブがありません。USB 機器をつないで「再スキャン」を押してください。"
                           Foreground="{StaticResource Muted}" Margin="0,4,0,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding FormatVolumes.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <WrapPanel Margin="0,8,0,0">
                    <Button Content="チェックしたドライブを同時にフォーマット" Command="{Binding FormatCheckedCommand}"
                            Style="{StaticResource DangerButton}" MinWidth="280" />
                </WrapPanel>
            </StackPanel>
        </GroupBox>

        <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1"
                CornerRadius="4" Padding="14">
            <StackPanel>
                <TextBlock Text="どれを選べばよいか" Style="{StaticResource Eyebrow}" />
                <TextBlock TextWrapping="Wrap" LineHeight="21" Foreground="{StaticResource Muted}">
                    自分で使い続けるドライブなら簡易フォーマットで十分です。
                    調子が悪いドライブの再利用や、譲渡・廃棄の前にはディープフォーマットを選んでください。
                    ファイルを残したまま「削除したはずのデータ」だけを消したいときは、空き領域の上書きが使えます。
                </TextBlock>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
