<UserControl x:Class="DiskManager.Views.HealthView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="24,20,24,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 判定 -->
        <Border Grid.Row="0" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1"
                CornerRadius="4" Padding="18,16" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Width="96" Height="96" CornerRadius="48" VerticalAlignment="Top"
                        Background="Transparent" BorderThickness="4"
                        BorderBrush="{Binding SmartSummary, Converter={StaticResource HealthBrush}}">
                    <TextBlock Text="{Binding SmartSummary}" FontSize="19" FontWeight="SemiBold"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="{Binding SmartSummary, Converter={StaticResource HealthBrush}}" />
                </Border>

                <StackPanel Grid.Column="1" Margin="20,2,0,0">
                    <TextBlock Text="S.M.A.R.T. による判定" Style="{StaticResource Eyebrow}" />
                    <TextBlock Text="{Binding SmartDetail}" TextWrapping="Wrap" LineHeight="22" Margin="0,0,0,10" />
                    <TextBlock Text="{Binding SmartVitals}" Style="{StaticResource Mono}" FontSize="11.5"
                               Foreground="{StaticResource Accent}" TextWrapping="Wrap" />
                </StackPanel>
            </Grid>
        </Border>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,6">
            <Button Content="健康状態を取得" Command="{Binding LoadSmartCommand}" MinWidth="140" />
            <TextBlock VerticalAlignment="Center" Margin="6,0,0,8" Foreground="{StaticResource Muted}" FontSize="11.5"
                       Text="ドライブ本体が記録している劣化指標を読み出します。" />
        </StackPanel>

        <TextBlock Grid.Row="2" Text="属性一覧（しきい値を下回った属性は不良と判定されます）"
                   Style="{StaticResource Eyebrow}" Margin="0,6,0,6" />

        <DataGrid Grid.Row="3" ItemsSource="{Binding SmartAttributes}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding IdText}" Width="100"
                                    FontFamily="{StaticResource MonoFont}" />
                <DataGridTextColumn Header="属性" Binding="{Binding Name}" Width="*" />
                <DataGridTextColumn Header="現在値" Binding="{Binding Current}" Width="80" />
                <DataGridTextColumn Header="最悪値" Binding="{Binding Worst}" Width="80" />
                <DataGridTextColumn Header="しきい値" Binding="{Binding ThresholdText}" Width="90" />
                <DataGridTextColumn Header="生の値" Binding="{Binding RawText}" Width="140"
                                    FontFamily="{StaticResource MonoFont}" />
                <DataGridTemplateColumn Header="判定" Width="90">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Judgement}" VerticalAlignment="Center"
                                       Foreground="{Binding Judgement, Converter={StaticResource HealthBrush}}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
